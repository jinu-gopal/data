      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
    </svg>
  );
}

function parseApiError(
  text: string,
  status: number,
  action = "Request"
): string {
  if (!text) {
    return `${action} failed with HTTP ${status}.`;
  }

  try {
    const data = JSON.parse(text) as ApiError;

    if (data.message) {
      return `${action} failed (${status}): ${data.message}`;
    }

    if (data.error) {
      return `${action} failed (${status}): ${data.error}`;
    }

    return `${action} failed (${status}): ${text}`;
  } catch {
    return `${action} failed (${status}): ${text}`;
  }
}

export default function BusinessObjectPage() {
  const params = useParams();

  const businessObjectId =
    typeof params.businessObjectId === "string"
      ? params.businessObjectId
      : "";

  const [fields, setFields] = useState<Field[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [showAddField, setShowAddField] =
    useState(false);

  const [showEditField, setShowEditField] =
    useState(false);

  const [openActionsId, setOpenActionsId] =
    useState<string | null>(null);

  const [editingField, setEditingField] =
    useState<Field | null>(null);

  const [search, setSearch] = useState("");

  // ============================================================
  // FORM STATE
  // ============================================================

  const [fieldKey, setFieldKey] = useState("");
  const [label, setLabel] = useState("");
  const [description, setDescription] =
    useState("");

  const [fieldType, setFieldType] =
    useState("TEXT");

  const [required, setRequired] =
    useState(false);

  const [uniqueValue, setUniqueValue] =
    useState(false);

  const [readOnly, setReadOnly] =
    useState(false);

  const [hidden, setHidden] =
    useState(false);

  const [defaultValue, setDefaultValue] =
    useState("");

  const [minValue, setMinValue] =
    useState("");

  const [maxValue, setMaxValue] =
    useState("");

  const [validationPattern, setValidationPattern] =
    useState("");

  const [displayOrder, setDisplayOrder] =
    useState("0");

  // ============================================================
  // LOAD FIELDS
  // ============================================================

  async function loadFields() {
    if (!businessObjectId) {
      return;
    }

    try {
      setLoading(true);
      setError("");

      const response = await fetch(
        `/api/configuration/business-objects/${businessObjectId}/fields`,
        {
          method: "GET",
          cache: "no-store",
        }
      );

      const text = await response.text();

      if (!response.ok) {
        throw new Error(
          parseApiError(
            text,
            response.status,
            "Load fields"
          )
        );
      }

      if (!text) {
        setFields([]);
        return;
      }

      try {
        const data = JSON.parse(text);

        setFields(
          Array.isArray(data) ? data : []
        );
      } catch {
        throw new Error(
          "The server returned invalid JSON."
        );
      }
    } catch (err) {
      console.error(
        "LOAD FIELDS ERROR:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Unable to load fields."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadFields();
  }, [businessObjectId]);

  // ============================================================
  // RESET FORM
  // ============================================================

  function resetForm() {
    setFieldKey("");
    setLabel("");
    setDescription("");
    setFieldType("TEXT");
    setRequired(false);
    setUniqueValue(false);
    setReadOnly(false);
    setHidden(false);
    setDefaultValue("");
    setMinValue("");
    setMaxValue("");
    setValidationPattern("");
    setDisplayOrder("0");
  }

  // ============================================================
  // CLOSE ADD MODAL
  // ============================================================

  function closeAddModal() {
    if (saving) {
      return;
    }

    setShowAddField(false);
    resetForm();
    setError("");
  }

  // ============================================================
  // CLOSE EDIT MODAL
  // ============================================================

  function closeEditModal() {
    if (saving) {
      return;
    }

    setShowEditField(false);
    setEditingField(null);
    resetForm();
    setError("");
  }

  // ============================================================
  // OPEN EDIT MODAL
  // ============================================================

  function openEditField(field: Field) {
    setOpenActionsId(null);
    setEditingField(field);

    setFieldKey(field.fieldKey);
    setLabel(field.label);
    setDescription(
      field.description ?? ""
    );
    setFieldType(field.fieldType);

    setRequired(field.required);
    setUniqueValue(field.uniqueValue);
    setReadOnly(field.readOnly);
    setHidden(field.hidden);

    setDefaultValue(
      field.defaultValue ?? ""
    );

    setMinValue(
      field.minValue !== null
        ? String(field.minValue)
        : ""
    );

    setMaxValue(
      field.maxValue !== null
        ? String(field.maxValue)
        : ""
    );

    setValidationPattern(
      field.validationPattern ?? ""
    );

    setDisplayOrder(
      String(field.displayOrder)
    );

    setError("");
    setSuccess("");
    setShowEditField(true);
  }

  // ============================================================
  // CREATE FIELD
  // ============================================================

  async function createField(
    event: React.FormEvent
  ) {
    event.preventDefault();

    setError("");
    setSuccess("");

    const cleanKey =
      fieldKey.trim().toLowerCase();

    const cleanLabel = label.trim();

    if (!cleanKey) {
      setError("Field key is required.");
      return;
    }

    if (!/^[a-z][a-z0-9_]*$/.test(cleanKey)) {
      setError(
        "Field key must start with a lowercase letter and contain only lowercase letters, numbers, and underscores."
      );
      return;
    }

    if (!cleanLabel) {
      setError("Display label is required.");
      return;
    }

    try {
      setSaving(true);

      const parsedMinValue =
        minValue.trim() !== ""
          ? Number(minValue)
          : null;

      const parsedMaxValue =
        maxValue.trim() !== ""
          ? Number(maxValue)
          : null;

      if (
        parsedMinValue !== null &&
        Number.isNaN(parsedMinValue)
      ) {
        setError(
          "Minimum value must be a valid number."
        );
        return;
      }

      if (
        parsedMaxValue !== null &&
        Number.isNaN(parsedMaxValue)
      ) {
        setError(
          "Maximum value must be a valid number."
        );
        return;
      }

      if (
        parsedMinValue !== null &&
        parsedMaxValue !== null &&
        parsedMinValue > parsedMaxValue
      ) {
        setError(
          "Minimum value cannot be greater than maximum value."
        );
        return;
      }

      const parsedDisplayOrder =
        Number(displayOrder);

      if (
        Number.isNaN(parsedDisplayOrder) ||
        parsedDisplayOrder < 0
      ) {
        setError(
          "Display order must be zero or greater."
        );
        return;
      }

      const payload = {
        fieldKey: cleanKey,
        label: cleanLabel,
        description:
          description.trim() || null,
        fieldType,
        required,
        uniqueValue,
        readOnly,
        hidden,
        defaultValue:
          defaultValue.trim() || null,
        minValue: parsedMinValue,
        maxValue: parsedMaxValue,
        validationPattern:
          validationPattern.trim() || null,
        displayOrder: parsedDisplayOrder,
      };

      console.log(
        "MAX ERP CREATE FIELD PAYLOAD",
        payload
      );

      const response = await fetch(
        `/api/configuration/business-objects/${businessObjectId}/fields`,
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      const responseText =
        await response.text();

      console.log(
        "MAX ERP CREATE FIELD RESPONSE",
        {
          status: response.status,
          statusText: response.statusText,
          body: responseText,
        }
      );

      if (!response.ok) {
        throw new Error(
          parseApiError(
            responseText,
            response.status,
            "Create field"
          )
        );
      }

      await loadFields();

      setShowAddField(false);
      resetForm();

      setSuccess(
        `"${cleanLabel}" was created successfully.`
      );
    } catch (err) {
      console.error(
        "CREATE FIELD ERROR:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Unable to create field."
      );
    } finally {
      setSaving(false);
    }
  }

  // ============================================================
  // UPDATE FIELD
  // ============================================================

  async function updateField(
    event: React.FormEvent
  ) {
    event.preventDefault();

    if (!editingField) {
      return;
    }

    setError("");
    setSuccess("");

    const cleanLabel = label.trim();

    if (!cleanLabel) {
      setError("Display label is required.");
      return;
    }

    const parsedMinValue =
      minValue.trim() !== ""
        ? Number(minValue)
        : null;

    const parsedMaxValue =
      maxValue.trim() !== ""
        ? Number(maxValue)
        : null;

    if (
      parsedMinValue !== null &&
      Number.isNaN(parsedMinValue)
    ) {
      setError(
        "Minimum value must be a valid number."
      );
      return;
    }

    if (
      parsedMaxValue !== null &&
      Number.isNaN(parsedMaxValue)
    ) {
      setError(
        "Maximum value must be a valid number."
      );
      return;
    }

    if (
      parsedMinValue !== null &&
      parsedMaxValue !== null &&
      parsedMinValue > parsedMaxValue
    ) {
      setError(
        "Minimum value cannot be greater than maximum value."
      );
      return;
    }

    const parsedDisplayOrder =
      Number(displayOrder);

    if (
      Number.isNaN(parsedDisplayOrder) ||
      parsedDisplayOrder < 0
    ) {
      setError(
        "Display order must be zero or greater."
      );
      return;
    }

    try {
      setSaving(true);

      const payload = {
        label: cleanLabel,

        description:
          description.trim(),

        fieldType,

        required,

        uniqueValue,

        readOnly,

        hidden,

        defaultValue:
          defaultValue.trim(),

        minValue:
          parsedMinValue,

        maxValue:
          parsedMaxValue,

        validationPattern:
          validationPattern.trim(),

        displayOrder:
          parsedDisplayOrder,
      };

      console.log(
        "MAX ERP UPDATE FIELD PAYLOAD",
        payload
      );

      const response = await fetch(
        `/api/configuration/business-objects/${businessObjectId}/fields?fieldId=${encodeURIComponent(
          editingField.id
        )}`,
        {
          method: "PUT",
          headers: {
            "Content-Type":
              "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      const responseText =
        await response.text();

      console.log(
        "MAX ERP UPDATE FIELD RESPONSE",
        {
          status: response.status,
          statusText: response.statusText,
          body: responseText,
        }
      );

      if (!response.ok) {
        throw new Error(
          parseApiError(
            responseText,
            response.status,
            "Update field"
          )
        );
      }

      await loadFields();

      setShowEditField(false);
      setEditingField(null);
      resetForm();

      setSuccess(
        `"${cleanLabel}" was updated successfully.`
      );
    } catch (err) {
      console.error(
        "UPDATE FIELD ERROR:",
        err
      );

      setError(
        err instanceof Error
          ? err.message
          : "Unable to update field."
      );
    } finally {
      setSaving(false);
    }
  }

  // ============================================================
  // FILTER
  // ============================================================

  const filteredFields =
    fields.filter((field) => {
      const query =
        search.trim().toLowerCase();

      if (!query) {
        return true;
      }

      return (
        field.label
          .toLowerCase()
          .includes(query) ||
        field.fieldKey
          .toLowerCase()
          .includes(query) ||
        field.fieldType
          .toLowerCase()
          .includes(query)
      );
    });

  const requiredCount =
    fields.filter(
      (field) => field.required
    ).length;

  return (
    <main className="min-h-screen bg-[#f5f7fb] text-slate-900">

      {/* ====================================================== */}
      {/* HEADER */}
      {/* ====================================================== */}

      <header className="border-b border-slate-200 bg-white">

        <div className="mx-auto flex max-w-[1500px] items-center justify-between px-6 py-4">

          <div className="flex items-center gap-4">

            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
              <span className="text-lg font-bold">
                M
              </span>
            </div>

            <div>
              <p className="text-xs font-bold tracking-[0.16em] text-blue-600">
                MAX ERP
              </p>

              <p className="text-sm font-semibold text-slate-700">
                Configuration Studio
              </p>
            </div>

            <div className="mx-2 hidden h-7 w-px bg-slate-200 sm:block" />

            <div className="hidden text-sm text-slate-500 sm:block">
              Business Objects
              <span className="mx-2 text-slate-300">
                /
              </span>
              <span className="font-medium text-slate-800">
                Customer
              </span>
            </div>

          </div>

          <div className="flex items-center gap-3">

            <span className="hidden rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 sm:inline-flex">
              DRAFT
            </span>

            <span className="hidden text-xs text-slate-400 md:inline">
              Version 1
            </span>

            <button
              type="button"
              className="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
            >
              Save Draft
            </button>

            <button
              type="button"
              className="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
            >
              Publish
            </button>

          </div>

        </div>

      </header>

      <div className="mx-auto max-w-[1500px] px-6 py-8">

        {/* ==================================================== */}
        {/* TITLE */}
        {/* ==================================================== */}

        <section className="mb-8">

          <div className="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">

            <div>

              <div className="mb-3 flex items-center gap-2 text-sm text-slate-500">

                <span>
                  Configuration
                </span>

                <ChevronIcon />

                <span>
                  Business Objects
                </span>

                <ChevronIcon />

                <span className="font-medium text-slate-700">
                  Customer
                </span>

              </div>

              <div className="flex items-center gap-4">

                <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">

                  <svg
                    viewBox="0 0 24 24"
                    className="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="1.8"
                  >
                    <circle
                      cx="12"
                      cy="8"
                      r="3.5"
                    />

                    <path d="M5 20c.7-3.7 3-5.5 7-5.5s6.3 1.8 7 5.5" />
                  </svg>

                </div>

                <div>

                  <h1 className="text-3xl font-bold tracking-tight text-slate-950">
                    Customer
                  </h1>

                  <p className="mt-1 text-sm text-slate-500">
                    Define the data structure and behavior of the Customer object.
                  </p>

                </div>

              </div>

            </div>

            <div className="grid grid-cols-3 gap-3">

              <div className="min-w-[100px] rounded-xl border border-slate-200 bg-white px-4 py-3">

                <p className="text-xs font-medium text-slate-400">
                  Fields
                </p>

                <p className="mt-1 text-xl font-bold text-slate-900">
                  {fields.length}
                </p>

              </div>

              <div className="min-w-[100px] rounded-xl border border-slate-200 bg-white px-4 py-3">

                <p className="text-xs font-medium text-slate-400">
                  Required
                </p>

                <p className="mt-1 text-xl font-bold text-slate-900">
                  {requiredCount}
                </p>

              </div>

              <div className="min-w-[100px] rounded-xl border border-slate-200 bg-white px-4 py-3">

                <p className="text-xs font-medium text-slate-400">
                  Status
                </p>

                <p className="mt-1 text-sm font-bold text-amber-600">
                  Draft
                </p>

              </div>

            </div>

          </div>

        </section>

        {/* ==================================================== */}
        {/* SUCCESS */}
        {/* ==================================================== */}

        {success && (
          <div className="mb-6 flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">

            <span>
              <strong>
                Success:
              </strong>{" "}
              {success}
            </span>

            <button
              type="button"
              onClick={() =>
                setSuccess("")
              }
              className="font-semibold text-emerald-700"
            >
              Dismiss
            </button>

          </div>
        )}

        {/* ==================================================== */}
        {/* ERROR */}
        {/* ==================================================== */}

        {error &&
          !showAddField &&
          !showEditField && (
            <div className="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">

              <strong>
                Error:
              </strong>{" "}
              {error}

            </div>
          )}

        {/* ==================================================== */}
        {/* TABS */}
        {/* ==================================================== */}

        <div className="mb-6 overflow-x-auto border-b border-slate-200">

          <div className="flex min-w-max gap-7">

            {[
              "Overview",
              "Fields",
              "Relationships",
              "Rules",
              "Workflows",
              "Permissions",
              "Audit",
            ].map((tab) => (

              <button
                key={tab}
                type="button"
                className={`relative pb-4 text-sm font-medium ${
                  tab === "Fields"
                    ? "text-blue-600"
                    : "text-slate-500 hover:text-slate-800"
                }`}
              >

                {tab}

                {tab === "Fields" && (
                  <span className="absolute bottom-0 left-0 right-0 h-0.5 rounded-full bg-blue-600" />
                )}

              </button>

            ))}

          </div>

        </div>

        {/* ==================================================== */}
        {/* FIELDS CARD */}
        {/* ==================================================== */}

        <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">

          {/* TOOLBAR */}

          <div className="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">

            <div>

              <h2 className="text-lg font-bold text-slate-900">
                Fields
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                Manage the fields available on Customer records.
              </p>

            </div>

            <div className="flex flex-col gap-3 sm:flex-row">

              <div className="relative">

                <span className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                  <SearchIcon />
                </span>

                <input
                  value={search}
                  onChange={(e) =>
                    setSearch(
                      e.target.value
                    )
                  }
                  placeholder="Search fields..."
                  className="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 pl-9 pr-4 text-sm outline-none transition focus:border-blue-400 focus:bg-white sm:w-64"
                />

              </div>

              <button
                type="button"
                className="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-600 hover:bg-slate-50"
              >
                <SlidersIcon />
                Filter
              </button>

              <button
                type="button"
                onClick={() => {
                  setError("");
                  setSuccess("");
                  resetForm();
                  setShowAddField(true);
                }}
                className="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
              >
                <PlusIcon />
                Add Field
              </button>

            </div>

          </div>

          {/* CONTENT */}

          {loading ? (

            <div className="p-16 text-center">

              <div className="mx-auto h-8 w-8 animate-spin rounded-full border-2 border-slate-200 border-t-blue-600" />

              <p className="mt-4 text-sm text-slate-500">
                Loading configuration...
              </p>

            </div>

          ) : filteredFields.length === 0 ? (

            <div className="p-16 text-center">

              <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">

                <svg
                  viewBox="0 0 24 24"
                  className="h-7 w-7"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="1.7"
                >
                  <rect
                    x="4"
                    y="4"
                    width="16"
                    height="16"
                    rx="2"
                  />

                  <path d="M8 9h8M8 13h5M8 17h3" />

                </svg>

              </div>

              <h3 className="mt-5 text-base font-bold text-slate-800">
                {search
                  ? "No matching fields"
                  : "No fields configured yet"}
              </h3>

              <p className="mx-auto mt-2 max-w-md text-sm text-slate-500">
                {search
                  ? "Try another search term."
                  : "Create your first field to define the Customer data model."}
              </p>

              {!search && (
                <button
                  type="button"
                  onClick={() => {
                    resetForm();
                    setShowAddField(true);
                  }}
                  className="mt-6 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
                >
                  <PlusIcon />
                  Create First Field
                </button>
              )}

            </div>

          ) : (

            <div className="overflow-x-auto">

              <table className="w-full min-w-[980px]">

                <thead>

                  <tr className="border-b border-slate-200 bg-slate-50/70 text-left">

                    <th className="px-6 py-3 text-xs font-bold uppercase tracking-wide text-slate-400">
                      Field
                    </th>

                    <th className="px-6 py-3 text-xs font-bold uppercase tracking-wide text-slate-400">
                      Type
                    </th>

                    <th className="px-6 py-3 text-xs font-bold uppercase tracking-wide text-slate-400">
                      Rules
                    </th>

                    <th className="px-6 py-3 text-xs font-bold uppercase tracking-wide text-slate-400">
                      Default
                    </th>

                    <th className="px-6 py-3 text-right text-xs font-bold uppercase tracking-wide text-slate-400">
                      Order
                    </th>

                    <th className="w-16 px-4 py-3 text-right text-xs font-bold uppercase tracking-wide text-slate-400">
                      Actions
                    </th>

                  </tr>

                </thead>

                <tbody className="divide-y divide-slate-100">

                  {filteredFields.map(
                    (field) => (

                      <tr
                        key={field.id}
                        className="group hover:bg-slate-50/70"
                      >

                        <td className="px-6 py-4">

                          <div className="flex items-center gap-3">

                            <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-xs font-bold text-blue-600">
                              {field.label
                                .slice(0, 1)
                                .toUpperCase()}
                            </div>

                            <div>

                              <p className="font-semibold text-slate-800">
                                {field.label}
                              </p>

                              <p className="mt-0.5 font-mono text-xs text-slate-400">
                                {field.fieldKey}
                              </p>

                            </div>

                          </div>

                        </td>

                        <td className="px-6 py-4">

                          <span className="inline-flex rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                            {FIELD_TYPE_LABELS[
                              field.fieldType
                            ] ??
                              field.fieldType}
                          </span>

                        </td>

                        <td className="px-6 py-4">

                          <div className="flex flex-wrap gap-1.5">

                            {field.required && (
                              <span className="rounded-md bg-blue-50 px-2 py-1 text-[11px] font-semibold text-blue-700">
                                Required
                              </span>
                            )}

                            {field.uniqueValue && (
                              <span className="rounded-md bg-purple-50 px-2 py-1 text-[11px] font-semibold text-purple-700">
                                Unique
                              </span>
                            )}

                            {field.readOnly && (
                              <span className="rounded-md bg-amber-50 px-2 py-1 text-[11px] font-semibold text-amber-700">
                                Read only
                              </span>
                            )}

                            {field.hidden && (
                              <span className="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-500">
                                Hidden
                              </span>
                            )}

                            {!field.required &&
                              !field.uniqueValue &&
                              !field.readOnly &&
                              !field.hidden && (
                                <span className="text-xs text-slate-400">
                                  No rules
                                </span>
                              )}

                          </div>

                        </td>

                        <td className="px-6 py-4 text-sm text-slate-500">
                          {field.defaultValue ||
                            "—"}
                        </td>

                        <td className="px-6 py-4 text-right font-mono text-xs text-slate-400">
                          {field.displayOrder}
                        </td>

                        {/* ACTIONS */}

                        <td className="relative px-4 py-4 text-right">

                          <button
                            type="button"
                            onClick={() =>
                              setOpenActionsId(
                                openActionsId ===
                                  field.id
                                  ? null
                                  : field.id
                              )
                            }
                            className="inline-flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                            aria-label={`Actions for ${field.label}`}
                          >
                            <MoreIcon />
                          </button>

                          {openActionsId ===
                            field.id && (

                            <div className="absolute right-4 top-14 z-30 w-48 overflow-hidden rounded-xl border border-slate-200 bg-white py-1 text-left shadow-xl">

                              <button
                                type="button"
                                onClick={() =>
                                  openEditField(
                                    field
                                  )
                                }
                                className="flex w-full items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                              >
                                <EditIcon />
                                Edit field
                              </button>

                            </div>

                          )}

                        </td>

                      </tr>

                    )
                  )}

                </tbody>

              </table>

            </div>

          )}

          <div className="border-t border-slate-200 bg-slate-50/50 px-6 py-3">

            <p className="text-xs text-slate-400">
              Configuration changes are saved as draft until published.
            </p>

          </div>

        </section>

      </div>

      {/* ====================================================== */}
      {/* ADD FIELD MODAL */}
      {/* ====================================================== */}

      {showAddField && (

        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4 backdrop-blur-sm">

          <div className="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

            <div className="flex items-center justify-between border-b border-slate-200 px-6 py-5">

              <div>

                <h2 className="text-lg font-bold text-slate-900">
                  Add Field
                </h2>

                <p className="mt-1 text-sm text-slate-500">
                  Define a new field for the Customer object.
                </p>

              </div>

              <button
                type="button"
                onClick={closeAddModal}
                disabled={saving}
                className="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700 disabled:opacity-50"
              >
                <XIcon />
              </button>

            </div>

            <form
              onSubmit={createField}
              className="max-h-[75vh] overflow-y-auto"
            >

              <div className="space-y-6 p-6">

                {error && (

                  <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">

                    <p className="font-semibold">
                      Field creation failed
                    </p>

                    <p className="mt-1 break-words">
                      {error}
                    </p>

                  </div>

                )}

                <div>

                  <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Basic Information
                  </p>

                  <div className="grid gap-5 md:grid-cols-2">

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Field Key
                        <span className="ml-1 text-red-500">
                          *
                        </span>
                      </label>

                      <input
                        value={fieldKey}
                        onChange={(e) =>
                          setFieldKey(
                            e.target.value.toLowerCase()
                          )
                        }
                        placeholder="customer_code"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Display Label
                        <span className="ml-1 text-red-500">
                          *
                        </span>
                      </label>

                      <input
                        value={label}
                        onChange={(e) =>
                          setLabel(e.target.value)
                        }
                        placeholder="Customer Code"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                  </div>

                </div>

                <div>

                  <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Data Type
                  </p>

                  <div className="grid gap-5 md:grid-cols-2">

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Field Type
                      </label>

                      <select
                        value={fieldType}
                        onChange={(e) =>
                          setFieldType(e.target.value)
                        }
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      >

                        {FIELD_TYPES.map((type) => (

                          <option
                            key={type}
                            value={type}
                          >
                            {FIELD_TYPE_LABELS[type] ??
                              type}
                          </option>

                        ))}

                      </select>

                    </div>

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Default Value
                      </label>

                      <input
                        value={defaultValue}
                        onChange={(e) =>
                          setDefaultValue(
                            e.target.value
                          )
                        }
                        placeholder="Optional"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                  </div>

                </div>

                <div>

                  <label className="mb-2 block text-sm font-semibold text-slate-700">
                    Description
                  </label>

                  <textarea
                    value={description}
                    onChange={(e) =>
                      setDescription(
                        e.target.value
                      )
                    }
                    rows={3}
                    placeholder="Describe how this field is used..."
                    className="w-full resize-none rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                  />

                </div>

                <div>

                  <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Validation
                  </p>

                  <div className="grid gap-5 md:grid-cols-2">

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Minimum Value
                      </label>

                      <input
                        type="number"
                        value={minValue}
                        onChange={(e) =>
                          setMinValue(
                            e.target.value
                          )
                        }
                        placeholder="Optional"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                    <div>

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Maximum Value
                      </label>

                      <input
                        type="number"
                        value={maxValue}
                        onChange={(e) =>
                          setMaxValue(
                            e.target.value
                          )
                        }
                        placeholder="Optional"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                  </div>

                  <div className="mt-5">

                    <label className="mb-2 block text-sm font-semibold text-slate-700">
                      Validation Pattern
                    </label>

                    <input
                      value={validationPattern}
                      onChange={(e) =>
                        setValidationPattern(
                          e.target.value
                        )
                      }
                      placeholder="Optional regular expression"
                      className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                    />

                  </div>

                </div>

                <div>

                  <label className="mb-2 block text-sm font-semibold text-slate-700">
                    Display Order
                  </label>

                  <input
                    type="number"
                    min="0"
                    value={displayOrder}
                    onChange={(e) =>
                      setDisplayOrder(
                        e.target.value
                      )
                    }
                    className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                  />

                </div>

                <div>

                  <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Field Behavior
                  </p>

                  <div className="grid gap-3 sm:grid-cols-2">

                    {[
                      {
                        label: "Required",
                        description:
                          "Users must provide a value.",
                        value: required,
                        setValue:
                          setRequired,
                      },
                      {
                        label: "Unique",
                        description:
                          "Values cannot be duplicated.",
                        value:
                          uniqueValue,
                        setValue:
                          setUniqueValue,
                      },
                      {
                        label: "Read Only",
                        description:
                          "Users cannot manually edit it.",
                        value:
                          readOnly,
                        setValue:
                          setReadOnly,
                      },
                      {
                        label: "Hidden",
                        description:
                          "Hide this field from normal forms.",
                        value: hidden,
                        setValue:
                          setHidden,
                      },
                    ].map((option) => (

                      <label
                        key={option.label}
                        className={`flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition ${
                          option.value
                            ? "border-blue-200 bg-blue-50/50"
                            : "border-slate-200 bg-white hover:bg-slate-50"
                        }`}
                      >

                        <input
                          type="checkbox"
                          checked={
                            option.value
                          }
                          onChange={(e) =>
                            option.setValue(
                              e.target.checked
                            )
                          }
                          className="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                        />

                        <span>

                          <span className="block text-sm font-semibold text-slate-800">
                            {option.label}
                          </span>

                          <span className="mt-0.5 block text-xs text-slate-500">
                            {option.description}
                          </span>

                        </span>

                      </label>

                    ))}

                  </div>

                </div>

              </div>

              <div className="flex items-center justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-4">

                <button
                  type="button"
                  onClick={closeAddModal}
                  disabled={saving}
                  className="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-50"
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  disabled={saving}
                  className="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                >

                  {saving && (
                    <span className="h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white" />
                  )}

                  {saving
                    ? "Creating..."
                    : "Create Field"}

                </button>

              </div>

            </form>

          </div>

        </div>

      )}

      {/* ====================================================== */}
      {/* EDIT FIELD MODAL */}
      {/* ====================================================== */}

      {showEditField &&
        editingField && (

          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/40 p-4 backdrop-blur-sm">

            <div className="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

              <div className="flex items-center justify-between border-b border-slate-200 px-6 py-5">

                <div>

                  <div className="flex items-center gap-2">

                    <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                      <EditIcon />
                    </div>

                    <h2 className="text-lg font-bold text-slate-900">
                      Edit Field
                    </h2>

                  </div>

                  <p className="mt-1 text-sm text-slate-500">
                    Update the configuration of this field.
                  </p>

                </div>

                <button
                  type="button"
                  onClick={closeEditModal}
                  disabled={saving}
                  className="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700 disabled:opacity-50"
                >
                  <XIcon />
                </button>

              </div>

              <form
                onSubmit={updateField}
                className="max-h-[75vh] overflow-y-auto"
              >

                <div className="space-y-6 p-6">

                  {error && (

                    <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">

                      <p className="font-semibold">
                        Field update failed
                      </p>

                      <p className="mt-1 break-words">
                        {error}
                      </p>

                    </div>

                  )}

                  <div>

                    <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                      Basic Information
                    </p>

                    <div className="space-y-5">

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Field Key
                        </label>

                        <input
                          value={fieldKey}
                          disabled
                          className="h-11 w-full cursor-not-allowed rounded-lg border border-slate-200 bg-slate-100 px-3 font-mono text-sm text-slate-500"
                        />

                        <p className="mt-1.5 text-xs text-slate-400">
                          The technical field key cannot be changed.
                        </p>

                      </div>

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Display Label
                          <span className="ml-1 text-red-500">
                            *
                          </span>
                        </label>

                        <input
                          value={label}
                          onChange={(e) =>
                            setLabel(
                              e.target.value
                            )
                          }
                          placeholder="Customer Name"
                          className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                        />

                      </div>

                    </div>

                  </div>

                  <div>

                    <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                      Data Type
                    </p>

                    <div className="grid gap-5 md:grid-cols-2">

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Field Type
                        </label>

                        <select
                          value={fieldType}
                          onChange={(e) =>
                            setFieldType(
                              e.target.value
                            )
                          }
                          className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                        >

                          {FIELD_TYPES.map(
                            (type) => (

                              <option
                                key={type}
                                value={type}
                              >
                                {FIELD_TYPE_LABELS[
                                  type
                                ] ?? type}
                              </option>

                            )
                          )}

                        </select>

                      </div>

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Default Value
                        </label>

                        <input
                          value={
                            defaultValue
                          }
                          onChange={(e) =>
                            setDefaultValue(
                              e.target.value
                            )
                          }
                          placeholder="Optional"
                          className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                        />

                      </div>

                    </div>

                  </div>

                  <div>

                    <label className="mb-2 block text-sm font-semibold text-slate-700">
                      Description
                    </label>

                    <textarea
                      value={description}
                      onChange={(e) =>
                        setDescription(
                          e.target.value
                        )
                      }
                      rows={3}
                      placeholder="Describe how this field is used..."
                      className="w-full resize-none rounded-lg border border-slate-200 bg-slate-50 px-3 py-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                    />

                  </div>

                  <div>

                    <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                      Validation
                    </p>

                    <div className="grid gap-5 md:grid-cols-2">

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Minimum Value
                        </label>

                        <input
                          type="number"
                          value={minValue}
                          onChange={(e) =>
                            setMinValue(
                              e.target.value
                            )
                          }
                          placeholder="Optional"
                          className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                        />

                      </div>

                      <div>

                        <label className="mb-2 block text-sm font-semibold text-slate-700">
                          Maximum Value
                        </label>

                        <input
                          type="number"
                          value={maxValue}
                          onChange={(e) =>
                            setMaxValue(
                              e.target.value
                            )
                          }
                          placeholder="Optional"
                          className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                        />

                      </div>

                    </div>

                    <div className="mt-5">

                      <label className="mb-2 block text-sm font-semibold text-slate-700">
                        Validation Pattern
                      </label>

                      <input
                        value={
                          validationPattern
                        }
                        onChange={(e) =>
                          setValidationPattern(
                            e.target.value
                          )
                        }
                        placeholder="Optional regular expression"
                        className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                      />

                    </div>

                  </div>

                  <div>

                    <label className="mb-2 block text-sm font-semibold text-slate-700">
                      Display Order
                    </label>

                    <input
                      type="number"
                      min="0"
                      value={displayOrder}
                      onChange={(e) =>
                        setDisplayOrder(
                          e.target.value
                        )
                      }
                      className="h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-blue-500 focus:bg-white"
                    />

                  </div>

                  <div>

                    <p className="mb-4 text-xs font-bold uppercase tracking-wider text-slate-400">
                      Field Behavior
                    </p>

                    <div className="grid gap-3 sm:grid-cols-2">

                      {[
                        {
                          label:
                            "Required",
                          description:
                            "Users must provide a value.",
                          value:
                            required,
                          setValue:
                            setRequired,
                        },
                        {
                          label:
                            "Unique",
                          description:
                            "Values cannot be duplicated.",
                          value:
                            uniqueValue,
                          setValue:
                            setUniqueValue,
                        },
                        {
                          label:
                            "Read Only",
                          description:
                            "Users cannot manually edit it.",
                          value:
                            readOnly,
                          setValue:
                            setReadOnly,
                        },
                        {
                          label:
                            "Hidden",
                          description:
                            "Hide this field from normal forms.",
                          value:
                            hidden,
                          setValue:
                            setHidden,
                        },
                      ].map(
                        (option) => (

                          <label
                            key={
                              option.label
                            }
                            className={`flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition ${
                              option.value
                                ? "border-blue-200 bg-blue-50/50"
                                : "border-slate-200 bg-white hover:bg-slate-50"
                            }`}
                          >

                            <input
                              type="checkbox"
                              checked={
                                option.value
                              }
                              onChange={(
                                e
                              ) =>
                                option.setValue(
                                  e.target
                                    .checked
                                )
                              }
                              className="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                            />

                            <span>

                              <span className="block text-sm font-semibold text-slate-800">
                                {
                                  option.label
                                }
                              </span>

                              <span className="mt-0.5 block text-xs text-slate-500">
                                {
                                  option.description
                                }
                              </span>

                            </span>

                          </label>

                        )
                      )}

                    </div>

                  </div>

                </div>

                <div className="flex items-center justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-4">

                  <button
                    type="button"
                    onClick={
                      closeEditModal
                    }
                    disabled={saving}
                    className="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-50"
                  >
                    Cancel
                  </button>

                  <button
                    type="submit"
                    disabled={saving}
                    className="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                  >

                    {saving && (
                      <span className="h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white" />
                    )}

                    {saving
                      ? "Saving..."
                      : "Save Changes"}

                  </button>

                </div>

              </form>

            </div>

          </div>

        )}

    </main>
  );
}